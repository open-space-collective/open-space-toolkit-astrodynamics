        <definition>ProbabilityOfCollisionAlgorithm::Analysis ostk::astrodynamics::conjunction::ProbabilityOfCollisionAlgorithm::ComputeProbabilityAnalysis</definition>
        <argsstring>(const Shared&lt; const ProbabilityOfCollisionAlgorithm &gt; &amp;aProbabilityOfCollisionAlgorithmSPtr, const CloseApproach &amp;aCloseApproach, const Shared&lt; const HardBody &gt; &amp;aHardBody1SPtr, const Shared&lt; const HardBody &gt; &amp;aHardBody2SPtr, const bool &amp;scaleObject1Covariance=true, const bool &amp;scaleObject2Covariance=true)</argsstring>
        <name>ComputeProbabilityAnalysis</name>
        <param>
          <type>const Shared&lt; const <ref refid="classostk_1_1astrodynamics_1_1conjunction_1_1_probability_of_collision_algorithm" kindref="compound">ProbabilityOfCollisionAlgorithm</ref> &gt; &amp;</type>
          <declname>aProbabilityOfCollisionAlgorithmSPtr</declname>
        </param>
