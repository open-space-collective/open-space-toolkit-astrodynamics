        <argsstring>(double anAbscissa, double aMissDistanceX, double aMissDistanceY, double aSigmaX, double aSigmaY, double aCombinedHardBodyRadius)</argsstring>
        <name>ComputeIntegrand</name>
        <param>
          <type>double</type>
          <declname>anAbscissa</declname>
